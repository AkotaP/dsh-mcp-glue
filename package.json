{
  "name": "dsh-mcp-glue",
  "version": "0.3.0",
  "description": "Session-isolated workspace MCP declarations for DeepSeek Harness with extensible presets and a composer management UI",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./presets": "./src/presets.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "tools/build-client.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs",
    "examples",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "external": []
    }
  },
  "scripts": {
    "build": "node tools/build-client.mjs",
    "test": "node --test test/*.test.js",
    "check": "node tools/check.mjs",
    "prepack": "node tools/build-client.mjs",
    "pack": "pnpm pack"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "@iarna/toml": "^2.2.5",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2",
    "@deepseek-ai/dsh-mcp-resources": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "react": "^19.2.0",
    "react-dom": "^19.3.0"
  }
}
